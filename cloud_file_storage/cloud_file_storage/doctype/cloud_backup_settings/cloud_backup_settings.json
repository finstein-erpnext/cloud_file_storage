 "fields": [
  {
   "default": "0",
   "description": "Master switch. Nothing is dumped, uploaded or expired while this is off.",
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled"
  },
  {
   "fieldname": "sb_target",
   "fieldtype": "Section Break",
   "label": "Backup Target"
  },
  {
   "description": "Must not be the attachment bucket. Backup artifacts and live attachments never share a bucket \u2014 archive lifecycle rules belong on this one only.",
   "fieldname": "backup_bucket",
   "fieldtype": "Data",
   "label": "Backup Bucket"
  },
  {
   "default": "{site}/backups",
   "description": "The <code>{site}</code> token expands to the site name. Artifacts land under <code>&lt;prefix&gt;/&lt;frequency&gt;/&lt;timestamp&gt;/</code>.",
   "fieldname": "backup_prefix",
   "fieldtype": "Data",
   "label": "Backup Prefix"
  },
  {
   "fieldname": "target_column_break",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "description": "Reuse the region, endpoint and credentials from Cloud Storage Settings.",
   "fieldname": "use_storage_credentials",
   "fieldtype": "Check",
   "label": "Use Storage Credentials"
  },
  {
   "depends_on": "eval:!doc.use_storage_credentials",
